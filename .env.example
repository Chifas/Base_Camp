# ─── Auth ─────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── Database (Supabase) ──────────────────────────
# DATABASE_URL → connection pooler (puerto 6543) — para queries en producción
# DIRECT_URL   → conexión directa  (puerto 5432) — para db:push y migraciones
# Ambas en: Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Stripe (Premium subscription tier) ─────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create Products + Prices in the Stripe dashboard, paste the price IDs here.
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# ─── Daily.co (video calls) ──────────────────────
DAILY_API_KEY=your-daily-api-key

# ─── Resend (email) ──────────────────────────────
RESEND_API_KEY=re_...
# Sender shown in the From field — domain must be verified in Resend
# For local dev with the free tier you can use: onboarding@resend.dev
RESEND_FROM_EMAIL=GuidePath <noreply@guidepath.app>

# ─── Cloudinary (image uploads) ──────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Google OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Upstash Redis (rate limiting) ───────────────
# Optional: if not set, rate limiting is skipped silently
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Cron Jobs ───────────────────────────────────
# Required for protecting cron endpoints from unauthorized access
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here
