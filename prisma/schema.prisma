generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalCategory {
  PSYCHOLOGIST
  COACH
  CAREER_MENTOR
  NUTRITIONIST
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SESSION_CONFIRMED
  SESSION_CANCELLED
  SESSION_REMINDER
  NEW_REVIEW
  PAYMENT_RECEIVED
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  bio              String?
  role             UserRole  @default(CLIENT)
  freeCreditsUsed  Int       @default(0)
  creditsResetAt   DateTime?
  subscriptionTier String    @default("free")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts             Account[]
  sessions             AuthSession[]
  professionalProfile  ProfessionalProfile?
  clientSessions       Session[]            @relation("ClientSessions")
  reviews              Review[]
  notifications        Notification[]
  rescheduleRequests   RescheduleRequest[]
  betaFeedbacks        BetaFeedback[]
  referralsMade        Referral[]         @relation("ReferralReferrer")
  referralsReceived    Referral[]         @relation("ReferralReferred")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ProfessionalProfile {
  id                     String               @id @default(cuid())
  userId                 String               @unique
  category               ProfessionalCategory
  headline               String?
  hourlyRate             Float                @default(0)
  stripeAccountId        String?
  stripeConnected        Boolean              @default(false)
  rating                 Float                @default(0)
  reviewCount            Int                  @default(0)
  verified               Boolean              @default(false)
  verifiedAt             DateTime?
  languages              String[]             @default(["es"])
  yearsExperience        Int?
  impactPoints           Int                  @default(0)
  totalSessionsCompleted Int                  @default(0)
  socialImpactScore      Float                @default(0)
  onboardingDone         Boolean              @default(false)
  onboardingEmailStep    Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability    Availability[]
  sessions        Session[]           @relation("ProfessionalSessions")
  certifications  Certification[]
  redemptions     RewardRedemption[]

  @@index([category])
  @@map("professional_profiles")
}

model Session {
  id                    String        @id @default(cuid())
  clientId              String
  professionalId        String
  scheduledAt           DateTime
  duration              Int           @default(60) // minutes
  status                SessionStatus @default(PENDING)
  dailyRoomUrl          String?
  stripePaymentIntentId String?
  stripeTransferId      String?
  price                 Float         @default(0)
  isFreeSession         Boolean       @default(true)
  notes                 String?
  cancellationFee       Float?
  cancelledAt           DateTime?
  cancelledBy           String?
  reminderSent          Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client              User                @relation("ClientSessions", fields: [clientId], references: [id])
  professional        ProfessionalProfile @relation("ProfessionalSessions", fields: [professionalId], references: [id])
  review              Review?
  rescheduleRequests  RescheduleRequest[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@map("sessions")
}

model Review {
  id                    String    @id @default(cuid())
  sessionId             String    @unique
  userId                String
  rating                Int       // 1-5 overall
  ratingPunctuality     Int?      // 1-5
  ratingKnowledge       Int?      // 1-5
  ratingCommunication   Int?      // 1-5
  ratingValue           Int?      // 1-5
  comment               String?
  professionalResponse  String?
  respondedAt           DateTime?
  reported              Boolean   @default(false)
  reportReason          String?
  reportedAt            DateTime?
  createdAt             DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Certification {
  id              String              @id @default(cuid())
  professionalId  String
  title           String
  institution     String
  year            Int?
  documentUrl     String?
  createdAt       DateTime            @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("certifications")
}

model Availability {
  id              String @id @default(cuid())
  professionalId  String
  dayOfWeek       Int    // 0=Sunday, 6=Saturday
  startTime       String // "09:00" format
  endTime         String // "17:00" format

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("availability")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model RescheduleRequest {
  id          String           @id @default(cuid())
  sessionId   String
  proposedBy  String
  proposedAt  DateTime
  status      RescheduleStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposer User    @relation(fields: [proposedBy], references: [id])

  @@index([sessionId])
  @@map("reschedule_requests")
}

// ── Beta Feedback ──────────────────────────────────────────────────────────

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  rating    Int
  feedback  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("beta_feedbacks")
}

// ── Referrals ──────────────────────────────────────────────────────────────

enum ReferralType {
  PROFESSIONAL_TO_PROFESSIONAL
  CLIENT_TO_CLIENT
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model Referral {
  id           String         @id @default(cuid())
  code         String         @unique
  type         ReferralType
  referrerId   String
  referredId   String?
  status       ReferralStatus @default(PENDING)
  creditAmount Float?
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  referrer User  @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred User? @relation("ReferralReferred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ── Reward Redemptions ────────────────────────────────────────────────────

model RewardRedemption {
  id              String              @id @default(cuid())
  professionalId  String
  type            String              // "CERTIFICATION" | "DONATION"
  pointsSpent     Int
  description     String
  createdAt       DateTime            @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("reward_redemptions")
}

// ── Waitlist ───────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}
