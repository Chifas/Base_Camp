generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

// Task 14: subscriptionTier converted from String to enum
enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SESSION_CONFIRMED
  SESSION_CANCELLED
  SESSION_COMPLETED
  SESSION_REMINDER
  NEW_REVIEW
  PAYMENT_RECEIVED
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Task 4: RedemptionType converted from String to enum
enum RedemptionType {
  CERTIFICATION
  DONATION
}

model User {
  id                   String            @id @default(cuid())
  name                 String?
  email                String            @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  bio                  String?
  role                 UserRole          @default(CLIENT)
  freeCreditsUsed      Int               @default(0)
  creditsResetAt       DateTime?
  subscriptionTier     SubscriptionTier  @default(FREE)
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  subscriptionStatus   String?
  subscriptionEndsAt   DateTime?
  subscriptionInterval String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts             Account[]
  sessions             AuthSession[]
  professionalProfile  ProfessionalProfile?
  clientSessions       Session[]            @relation("ClientSessions")
  reviews              Review[]
  notifications        Notification[]
  rescheduleRequests   RescheduleRequest[]
  betaFeedbacks        BetaFeedback[]
  messages             Message[]
  referralsMade        Referral[]         @relation("ReferralReferrer")
  referralsReceived    Referral[]         @relation("ReferralReferred")
  conversations        Conversation[]     @relation("ClientConversations")
  directMessages       DirectMessage[]    @relation("DirectMessageSender")
  favorites            Favorite[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Webhook idempotency — Stripe retries duplicate events; we INSERT before processing
model StripeEventLog {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_event_log")
}

// Task 5: Dynamic categories — replaces ProfessionalCategory enum
model Category {
  id   String @id // e.g., "CAREER_MENTOR"
  name String
  slug String @unique

  @@map("categories")
}

model ProfessionalProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  category               String   // FK by convention to categories.id
  headline               String?
  hourlyRate             Float    @default(0)
  stripeAccountId        String?
  stripeConnected        Boolean  @default(false)
  rating                 Float    @default(0)
  reviewCount            Int      @default(0)
  verified               Boolean  @default(false)
  verifiedAt             DateTime?
  languages              String[] @default(["es"])
  yearsExperience        Int?
  impactPoints           Int      @default(0)
  totalSessionsCompleted Int      @default(0)
  socialImpactScore      Float    @default(0)
  onboardingDone         Boolean  @default(false)
  onboardingEmailStep    Int      @default(0)
  coverImage             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability    Availability[]
  blockedDates    BlockedDate[]
  sessions        Session[]           @relation("ProfessionalSessions")
  certifications  Certification[]
  redemptions     RewardRedemption[]
  conversations   Conversation[]
  favorites       Favorite[]

  @@index([category])
  @@map("professional_profiles")
}

model Favorite {
  id             String   @id @default(cuid())
  userId         String
  professionalId String
  createdAt      DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([userId])
  @@map("favorites")
}

model Session {
  id                    String        @id @default(cuid())
  clientId              String
  professionalId        String
  scheduledAt           DateTime
  duration              Int           @default(60)
  status                SessionStatus @default(PENDING)
  dailyRoomUrl          String?
  stripePaymentIntentId String?
  stripeTransferId      String?
  price                 Float         @default(0)
  isFreeSession         Boolean       @default(true)
  notes                 String?
  cancellationFee       Float?
  cancelledAt           DateTime?
  cancelledBy           String?
  reminderSent          Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client              User                @relation("ClientSessions", fields: [clientId], references: [id])
  professional        ProfessionalProfile @relation("ProfessionalSessions", fields: [professionalId], references: [id])
  review              Review?
  rescheduleRequests  RescheduleRequest[]
  messages            Message[]
  betaFeedbacks       BetaFeedback[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledAt])
  @@map("sessions")
}

model Review {
  id                    String    @id @default(cuid())
  sessionId             String    @unique
  userId                String
  rating                Int
  ratingPunctuality     Int?
  ratingKnowledge       Int?
  ratingCommunication   Int?
  ratingValue           Int?
  comment               String?
  professionalResponse  String?
  respondedAt           DateTime?
  reported              Boolean   @default(false)
  reportReason          String?
  reportedAt            DateTime?
  createdAt             DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  // Task 8: indexes for faster queries
  @@index([userId])
  @@index([createdAt])
  @@map("reviews")
}

model Certification {
  id              String   @id @default(cuid())
  professionalId  String
  title           String
  institution     String
  year            Int?
  documentUrl     String?
  createdAt       DateTime @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("certifications")
}

model Availability {
  id              String   @id @default(cuid())
  professionalId  String
  dayOfWeek       Int
  startTime       String
  endTime         String
  // When true, only Premium-tier clients can book this slot (priority booking benefit)
  priorityOnly    Boolean  @default(false)
  // Task 8: track when availability was last modified
  updatedAt       DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, dayOfWeek])
  @@map("availability")
}

model BlockedDate {
  id              String   @id @default(cuid())
  professionalId  String
  date            DateTime @db.Date
  reason          String?

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
  @@index([professionalId])
  @@map("blocked_dates")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model RescheduleRequest {
  id          String           @id @default(cuid())
  sessionId   String
  proposedBy  String
  proposedAt  DateTime
  status      RescheduleStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposer User    @relation(fields: [proposedBy], references: [id])

  @@index([sessionId])
  @@map("reschedule_requests")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  content   String
  type      String   @default("text")
  fileUrl   String?
  fileName  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("messages")
}

// Task 12: added session FK relation
model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  rating    Int
  feedback  String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("beta_feedbacks")
}

enum ReferralType {
  PROFESSIONAL_TO_PROFESSIONAL
  CLIENT_TO_CLIENT
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model Referral {
  id           String         @id @default(cuid())
  code         String         @unique
  type         ReferralType
  referrerId   String
  referredId   String?
  status       ReferralStatus @default(PENDING)
  creditAmount Float?
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  referrer User  @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred User? @relation("ReferralReferred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// Task 4: type field converted to RedemptionType enum
model RewardRedemption {
  id              String          @id @default(cuid())
  professionalId  String
  type            RedemptionType
  pointsSpent     Int
  description     String
  createdAt       DateTime        @default(now())

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@map("reward_redemptions")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

model Conversation {
  id              String   @id @default(cuid())
  clientId        String
  professionalId  String
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  client       User                @relation("ClientConversations", fields: [clientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  messages     DirectMessage[]

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
  @@map("conversations")
}

model DirectMessage {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_messages")
}
